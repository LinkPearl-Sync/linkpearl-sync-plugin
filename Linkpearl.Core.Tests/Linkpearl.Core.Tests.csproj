<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Les versions résolues sont figées dans packages.lock.json, avec
         l'empreinte de chaque paquet : la CI restaure en mode verrouillé, donc
         un paquet republié sous le même numéro, ou une dépendance transitive
         qui glisse, fait échouer la restauration au lieu de s'exécuter. Le
         plugin l'a déjà, par le SDK Dalamud. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>

    <!-- Directory.Build.props force InvariantGlobalization pour tout le
         dépôt, mais ce réglage n'a de sens que pour un exécutable qui
         démarre son propre hôte CLR : c'est le cas de ce projet de tests,
         jamais du plugin, chargé comme assembly dans le processus déjà
         lancé de Dalamud, dont l'hôte gouverne seul la globalisation.
         Sans cette dérogation, string.Normalize devient un passe-plat
         silencieux (aucune exception, aucune normalisation) faute des
         tables Unicode d'ICU, ce qui invaliderait tout test qui vérifie la
         normalisation NFC d'AdmissionSealing.ProofTag sans jamais le
         signaler. Conséquence : sous Linux, les tests exigent libicu
         (paquet libicu ou libicu-dev selon la distribution), faute de quoi
         le runtime refuse de démarrer. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!-- Pour vérifier le codec Moodles contre la vraie bibliothèque. Le noyau
         n'en dépend pas : il décode ce format à la main, dans ses bornes. -->
    <PackageReference Include="MemoryPack" Version="1.21.4" />
  </ItemGroup>

  <!-- Le noyau est compilé par inclusion de sources : référencer le plugin
       exigerait les assemblies Dalamud et un TargetFramework Windows, et ces
       tests cesseraient de tourner sous Linux. -->
  <ItemGroup>
    <None Include="Fixtures\protocol-vectors.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Les sources de l'interface, embarquées pour UiConventionTests. Jamais
       compilées ici : elles dépendent de Dalamud. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Linkpearl\Ui\**\*.cs" LinkBase="UiSources" />
  </ItemGroup>

  <Import Project="..\build\Core.Deps.props" />
  <Import Project="..\build\Core.Sources.props" />

</Project>
